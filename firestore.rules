rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra especial para convites:
    // Qualquer pessoa com o token pode LER o convite individual (get) para validar na tela de ativação.
    // Listagem e criação exigem autenticação.
    match /invites/{inviteId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if request.auth != null || (resource != null && request.resource.data.status == 'accepted');
    }

    // Regras para usuários:
    // Usuário autenticado pode ler/escrever seu próprio documento ou se for admin
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Regras para logs de auditoria:
    match /audit_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Regra padrão para demais coleções (organizations, teams, agreements, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
