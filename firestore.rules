rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Convites ──────────────────────────────────────────────
    // A validação do convite acontece antes do cadastro/login.
    // O link usa o token como ID do documento (invites/{token}),
    // portanto a validação pública deve ser um GET de documento,
    // nunca uma query/listagem da coleção.
    match /invites/{inviteId} {
      allow get: if resource.data.token == inviteId;
      allow list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // ── Organizações ─────────────────────────────────────────
    // Leitura individual (get): pública para exibir o nome da empresa na tela de boas-vindas do convite
    // Listagem e modificações: apenas usuários autenticados
    match /organizations/{orgId} {
      allow get: if true;
      allow list, write: if request.auth != null;

      match /{subcollection=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Logs de Auditoria ────────────────────────────────────
    match /audit_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ── Usuários ─────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── Regra padrão para demais coleções (teams, agreements, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
