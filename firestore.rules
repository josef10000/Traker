rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Convites ──────────────────────────────────────────────
    // Leitura individual (get): pública para validação do link de convite
    // Listagem (list): autenticados (admin/gerente vendo convites da empresa)
    // Criação (create): autenticados (admin/gerente gerando convites)
    // Atualização (update): autenticados (marcar como aceito)
    // Exclusão (delete): autenticados (admin removendo convite)
    match /invites/{inviteId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }

    // ── Logs de Auditoria ────────────────────────────────────
    // Criação pública para não bloquear registro de auditoria durante onboarding
    match /audit_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ── Usuários ─────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── Organizações e subcoleções ───────────────────────────
    match /organizations/{orgId} {
      allow read, write: if request.auth != null;

      match /{subcollection=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Regra padrão para demais coleções ────────────────────
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
