rules_version = '2';
// ⚠️  OBRIGATÓRIO: publicar neste banco NOMEADO (não no default):
//     ai-studio-764c464a-6ef4-407d-8079-cfe6869a3634
//     Firebase Console → Firestore → seletor de banco (topo) → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Convites ──────────────────────────────────────────────
    // get público: validar link de convite antes do cadastro
    match /invites/{inviteId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }

    // ── Organizações ─────────────────────────────────────────
    // get público: nome da empresa na tela de convite
    match /organizations/{orgId} {
      allow get: if true;
      allow list, write: if request.auth != null;

      match /{subcollection=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Logs de Auditoria ────────────────────────────────────
    match /audit_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ── Usuários ─────────────────────────────────────────────
    // Usuário autenticado pode ler/escrever (inclui criar o próprio perfil no aceite)
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── Demais coleções (teams, agreements, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
