rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Convites ──────────────────────────────────────────────
    // Leitura individual (get): pública para validação do link de convite antes do cadastro
    // Listagem, criação, atualização e exclusão: autenticados
    match /invites/{inviteId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }

    // ── Organizações ─────────────────────────────────────────
    // Leitura individual (get): pública para exibir o nome da empresa na tela de boas-vindas do convite
    // Listagem e modificações: apenas usuários autenticados
    match /organizations/{orgId} {
      allow get: if true;
      allow list, write: if request.auth != null;

      match /{subcollection=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Logs de Auditoria ────────────────────────────────────
    match /audit_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ── Usuários ─────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── Regra padrão para demais coleções (teams, agreements, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
