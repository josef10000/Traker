# ============================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo como .env.local e preencha os valores.
# ⚠️ NUNCA commitar o .env.local — ele está no .gitignore.
# ============================================================

# ── Gemini AI ────────────────────────────────────────────────
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Upstash Redis (Rate-Limit centralizado) ──────────────────
# Criar banco em: https://console.upstash.com
# Região recomendada: South America (sa-east-1)
# Copiar da aba "REST API" do banco criado
UPSTASH_REDIS_REST_URL="https://SEU_BANCO.upstash.io"
UPSTASH_REDIS_REST_TOKEN="SEU_TOKEN_UPSTASH"

# ── Resend (Envio de e-mail via API serverless) ───────────────
# Obter em: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ── Firebase App Check (reCAPTCHA Enterprise) ─────────────────
# Obter em: Firebase Console > App Check > Apps > Registrar > reCAPTCHA Enterprise
# Documentação: https://firebase.google.com/docs/app-check/web/recaptcha-enterprise-provider
VITE_RECAPTCHA_SITE_KEY="MY_RECAPTCHA_SITE_KEY"

# ── CRM Webhook Secret ────────────────────────────────────────
# Chave secreta compartilhada com o CRM para autenticar requisições de webhook
# Usada no endpoint /api/crm-webhook (Bearer token)
CRM_WEBHOOK_SECRET="MY_CRM_WEBHOOK_SECRET"
